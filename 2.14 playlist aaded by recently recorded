def insert_song(playlist, song):
    playlist = playlist.copy()
    playlist.append(song)

    i = len(playlist) - 1

    while i > 0 and playlist[i - 1][1] > song[1]:
        playlist[i] = playlist[i - 1]
        i -= 1

    playlist[i] = song

    return playlist


playlist = [
    ("Intro", 120),
    ("Chill Beat", 210),
    ("Long Jam", 340)
]

updated_playlist = insert_song(
    playlist,
    ("Quick Track", 180)
)

durations = [s[1] for s in updated_playlist]

assert durations == sorted([120, 210, 340, 180])
assert ("Quick Track", 180) in updated_playlist

print("All test cases passed!")
