import random

def bubble_sort_hand(hand):
    a = hand.copy()
    n = len(a)
    passes = 0

    for i in range(n - 1):
        swapped = False
        passes += 1

        for j in range(n - i - 1):
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swapped = True

        if not swapped:
            break

    return a, passes


# Nearly sorted hand
hand = [2, 4, 6, 8, 9, 11, 13]
hand.append(7)

final_hand, passes_incremental = bubble_sort_hand(hand)
assert final_hand == sorted(hand)

# Fully shuffled hand
shuffled = hand.copy()
random.shuffle(shuffled)

_, passes_full = bubble_sort_hand(shuffled)

assert passes_incremental <= passes_full

print("Nearly Sorted Passes :", passes_incremental)
print("Fully Shuffled Passes:", passes_full)
print("All test cases passed!")
