text = "DataStructuresAndAlgorithms"
pattern = "ALGORITHMS"

text = text.lower()
pattern = pattern.lower()

n = len(text)
m = len(pattern)

for i in range(n - m + 1):

    j = 0

    while j < m and text[i + j] == pattern[j]:
        j += 1

    if j == m:
        print("Pattern found at position", i)
        break
