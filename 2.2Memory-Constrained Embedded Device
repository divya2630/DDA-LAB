def selection_sort_min_writes(arr):
    # Create a copy so the original list is not modified
    a = arr.copy()
    n = len(a)
    swaps = 0

    # Selection Sort
    for i in range(n - 1):
        min_index = i

        # Find the minimum element
        for j in range(i + 1, n):
            if a[j] < a[min_index]:
                min_index = j

        # Swap only if needed
        if min_index != i:
            a[i], a[min_index] = a[min_index], a[i]
            swaps += 1

    return a, swaps


# Test Cases
res, sw = selection_sort_min_writes([23.5, 19.2, 25.1, 18.8, 21.4])
assert res == sorted([23.5, 19.2, 25.1, 18.8, 21.4])
assert sw <= len(res) - 1

res2, sw2 = selection_sort_min_writes([1, 2, 3, 4, 5])
assert sw2 == 0

print("All test cases passed!")
