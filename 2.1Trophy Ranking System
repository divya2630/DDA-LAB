def top_k_scores(scores, k):
    # Create a copy so the original list is not modified
    arr = scores.copy()
    n = len(arr)

    # If the list is empty, return an empty list
    if n == 0:
        return []

    # Perform only k passes (or n passes if n < k)
    for i in range(min(k, n)):
        max_index = i

        # Find the maximum element in the remaining array
        for j in range(i + 1, n):
            if arr[j] > arr[max_index]:
                max_index = j

        # Swap the maximum element with the current position
        arr[i], arr[max_index] = arr[max_index], arr[i]

    # Return only the top k elements
    return arr[:min(k, n)]


# Test Cases
assert top_k_scores([72, 88, 65, 90, 77, 95, 60, 83, 91, 68], 5) == [95, 91, 90, 88, 83]
assert top_k_scores([5, 3, 1], 5) == [5, 3, 1]   # Fewer than k items
assert top_k_scores([], 3) == []                 # Empty input

print("All test cases passed!")
