text = "MISSISSIPPI"
pattern = "ISSI"

n = len(text)
m = len(pattern)

for i in range(n - m + 1):
    comparisons = 0
    matched = True

    for j in range(m):
        comparisons += 1

        if text[i + j] != pattern[j]:
            matched = False
            break

    if matched:
        result = "Match"
    else:
        result = "Mismatch"

    print("Shift:", i, 
          "Comparisons:", comparisons, 
          "Result:", result)
