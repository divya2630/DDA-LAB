import time

def selection_sort(arr):
    # Create a copy so the original list is not modified
    a = arr.copy()
    n = len(a)

    # Selection Sort
    for i in range(n - 1):
        min_index = i

        # Find the minimum element
        for j in range(i + 1, n):
            if a[j] < a[min_index]:
                min_index = j

        # Swap only if necessary
        if min_index != i:
            a[i], a[min_index] = a[min_index], a[i]

    return a


# Example timing
items = [499, 129, 899, 45, 275, 60, 310, 150]

start = time.perf_counter()
sorted_items = selection_sort(items)
end = time.perf_counter()

print("Original List :", items)
print("Sorted List   :", sorted_items)
print("Execution Time:", (end - start) * 1_000_000, "microseconds")


# Test Cases
assert selection_sort([499, 129, 899, 45, 275, 60, 310, 150]) == \
       sorted([499, 129, 899, 45, 275, 60, 310, 150])

assert selection_sort([]) == []      # Empty list
assert selection_sort([7]) == [7]    # Single item

print("All test cases passed!")
